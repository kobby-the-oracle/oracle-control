# Copy to .env for local development. Replace every example secret.
ORACLE_DATABASE_URL=postgresql+psycopg://oracle:change-me@localhost:5432/oracle_control
ORACLE_EVIDENCE_DIR=./var/evidence
# local for development; switch to supabase after creating a private bucket and configuring server secrets.
ORACLE_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=oracle-control-evidence
# Managed Postgres deployments run Alembic migrations explicitly.
ORACLE_AUTO_CREATE_SCHEMA=false
ORACLE_MAX_UPLOAD_BYTES=26214400
# JSON object mapping API key to tenant, subject and roles. Use a secret manager outside local development.
ORACLE_API_KEYS={"replace-with-long-random-key":{"tenant_id":"demo-tenant","subject":"bootstrap-admin","roles":["admin","analyst","collector","auditor"]}}
ORACLE_ALLOW_DEV_TENANT_HEADER=false
POSTGRES_DB=oracle_control
POSTGRES_USER=oracle
POSTGRES_PASSWORD=change-me
# Optional OpenAI-compatible private or hosted model. Disabled unless explicitly enabled.
ORACLE_LLM_ENABLED=false
ORACLE_LLM_BASE_URL=
ORACLE_LLM_API_KEY=
ORACLE_LLM_MODEL=
ORACLE_LLM_TIMEOUT_SECONDS=30
ORACLE_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# Optional enterprise OIDC access-token validation. Configure values from your IdP.
# The frontend obtains tokens through your approved OIDC client; the API validates them.
ORACLE_OIDC_ISSUER=
ORACLE_OIDC_AUDIENCE=
ORACLE_OIDC_JWKS_URL=
ORACLE_OIDC_TENANT_CLAIM=tenant_id
ORACLE_OIDC_ROLE_CLAIM=roles
